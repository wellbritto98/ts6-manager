# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL="file:./data/ts6webui.db"
# REQUIRED in every environment — the backend refuses to start without these.
# There is deliberately no default: a fallback secret ships a known signing key.
# Generate each one separately with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
# Encrypts stored ServerQuery keys, SSH passwords, Discord tokens and TOTP
# secrets. MUST differ from JWT_SECRET, so leaking one does not expose the other.
# Changing it later makes existing encrypted rows unreadable — set it once.
ENCRYPTION_KEY=change-this-to-a-different-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Origin the browser actually uses to reach the UI. This is the CORS allow-list
# value, so it must match exactly — scheme, host and port. Behind a domain or a
# reverse proxy, put that URL here, not localhost.
FRONTEND_URL=http://localhost:5173
# Host port the frontend container publishes (Docker only). Change it here
# rather than editing docker-compose.yml, which git tracks.
FRONTEND_PORT=3000

# Media sidecar — shared secret for the sidecar HTTP API. Required only when the
# sidecar runs as its own container (SIDECAR_URL set); when the backend spawns it
# locally a random token is generated per process and this can stay unset.
SIDECAR_TOKEN=change-this-to-a-random-string

# YouTube cookie auto-refresh sidecar (optional). Required in docker compose
# files that include the yt-browser service. Leave unset for local pnpm dev
# without the sidecar — the Settings toggle will refuse to enable (HTTP 400).
# YT_BROWSER_URL=http://ts6-yt-browser:9090
# YT_BROWSER_NOVNC_URL=http://ts6-yt-browser:6080
YT_BROWSER_TOKEN=change-this-to-a-random-string

# AI Agent Gateway (disabled by default). When enabled, use distinct secrets
# with at least 32 characters; do not reuse JWT_SECRET or ENCRYPTION_KEY.
AI_AGENT_ENABLED=false
AI_GATEWAY_TOKEN=change-this-to-a-random-string-at-least-32-chars
# This is the same value Open WebUI calls FORWARD_USER_INFO_HEADER_JWT_SECRET.
# Set it once and map it to both containers.
AI_IDENTITY_JWT_SECRET=change-this-to-a-different-random-string-at-least-32-chars
# Keep destructive agent tools hidden unless this is explicitly true.
AI_DESTRUCTIVE_TOOLS_ENABLED=false
# Optional comma-separated Open WebUI admins. Emails are case-insensitive.
AI_ALLOWED_OPENWEBUI_USER_IDS=
AI_ALLOWED_OPENWEBUI_EMAILS=
# Optional public URL used by the TS6 Manager admin navigation item.
AI_ASSISTANT_PUBLIC_URL=

# Optional Open WebUI overlay credentials. Keep real values outside git.
OPENWEBUI_SECRET_KEY=change-this-to-a-random-string
OPENROUTER_API_KEY=
# Host port the Open WebUI container publishes (docker-compose.ai.yml only).
AI_WEBUI_PORT=3002

# Frontend (Vite env vars)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
# Optional build-time override for the AI Assistant public URL.
VITE_AI_ASSISTANT_URL=
